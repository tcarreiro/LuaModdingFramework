[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://example/scenes/runtime_playground.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="Card"]
bg_color = Color(0.083, 0.111, 0.156, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.24, 0.34, 0.46, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="RuntimePlayground" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.037, 0.051, 0.077, 1)
mouse_filter = 2

[node name="OuterMargin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 24

[node name="Body" type="VBoxContainer" parent="OuterMargin"]
layout_mode = 2
theme_override_constants/separation = 15

[node name="Eyebrow" type="Label" parent="OuterMargin/Body"]
